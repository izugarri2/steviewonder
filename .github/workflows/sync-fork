name: Sync Fork
on:
  schedule:
    - cron: '* * * * *' # Se ejecuta diariamente a las 00:00 UTC
  workflow_dispatch: # Permite ejecución manual

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout fork
        uses: actions/checkout@v4
        with:
          repository: izugarri2/steviewonder # Ejemplo: username/repo
          token: ${{ secrets.PAT }}
          fetch-depth: 0

      - name: Sync with upstream
        run: |
          git remote add upstream https://github.com/izugarri2/steviewonder.git
          git fetch upstream
          git checkout master
          git merge upstream/master
          git push origin master
        env:
          token: ${{ secrets.PAT }}
