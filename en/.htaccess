DirectoryIndex index.html
RewriteEngine On
RewriteBase /en/

<IfModule mod_rewrite.c>
    # 0. Redirigir externamente /index e /index.html a la raíz /
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^index(\.html)?$ /en/ [R=301,L,NC]

    # 1. Redirigir externamente de .html a sin .html manteniendo la carpeta /en/
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.+)\.html$ /en/$1 [R=301,L,NE]

    # 2. Reescritura interna: Servir el archivo .html dentro de /en/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Página de error 404 dentro de la carpeta /en/
ErrorDocument 404 /en/paginadeerror.html



