DirectoryIndex index.html
RewriteEngine On
RewriteBase /

<IfModule mod_rewrite.c>
    # 0. Redirigir externamente /index e /index.html a la raíz /
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^index(\.html)?$ / [R=301,L,NC]

    # 1. Redirigir externamente de .html a sin .html
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

    # 2. Reescritura interna: Servir el archivo .html sin mostrarlo en la URL
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html



