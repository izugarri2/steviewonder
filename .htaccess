DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0. Redirigir cualquier /index o /index.html (en raíz o subcarpetas) a su carpeta limpia
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index(\.html)?[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 1. Redirigir externamente de .html a sin .html (excluyendo index.html)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 2. Reescritura interna: Servir el archivo .html sin mostrarlo en la URL
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html




